# Bekreftelsesmail – miljøvariabler (legges inn i hostingen, f.eks. Vercel)
# Ikke commit ekte verdier.

# API-nøkkel fra https://resend.com (gratis nivå finnes)
RESEND_API_KEY=

# Avsenderadresse. Krever et verifisert domene i Resend.
