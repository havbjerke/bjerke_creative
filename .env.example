# Miljøvariabler (legges inn i hostingen, f.eks. Vercel). Ikke commit ekte verdier.

# --- Bekreftelsesmail (Resend) ---
# API-nøkkel fra https://resend.com (gratis nivå finnes)
RESEND_API_KEY=
# Avsenderadresse. Krever et verifisert domene i Resend.
# Til testing kan du bruke: Agrolife Mysen <onboarding@resend.dev>
MAIL_FROM=Agrolife Mysen <booking@dittdomene.no>
# E-postadressen som skal motta varsel om nye bookinger (Torild)
SALON_EMAIL=

# --- Adminpanel (/admin) ---
# Passordet operatøren logger inn med
ADMIN_PASSWORD=
# Hemmelig nøkkel for å signere innloggings-cookie (en lang tilfeldig streng)
ADMIN_SECRET=

# --- Database (Vercel KV / Upstash Redis) ---
# Disse settes AUTOMATISK når du legger til "KV" under Storage i Vercel.
# (Trenger normalt ikke fylles inn manuelt.)
KV_REST_API_URL=
KV_REST_API_TOKEN=
